<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Keep the NuGet global-packages folder inside the repository.

    Rationale: in restricted sandboxes/CI the user-level cache
    (~/.nuget/packages) can be read-only, which makes `dotnet restore` fail.
    A repo-local folder always works, keeps the machine clean, and is
    gitignored. Normal developer machines are unaffected functionally.
  -->
  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>

  <!--
    Note: in restricted environments NuGet may emit `warning NU1900: Error occurred
    while getting package vulnerability data` because its user-level HTTP cache
    (~/.local/share/NuGet/http-cache) is read-only. The warning is non-fatal:
    restore/build/test all succeed. The HTTP cache location can be redirected with
    the NUGET_HTTP_CACHE_PATH environment variable if desired.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
