<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Keep the NuGet global-packages folder inside the repository.

    Rationale: in restricted sandboxes/CI the user-level cache
    (~/.nuget/packages) can be read-only, which makes `dotnet restore` fail.
    A repo-local folder always works, keeps the machine clean, and is
    gitignored. Normal developer machines are unaffected functionally.
  -->
  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
    <!-- Vulnerability audit wants to write to the user-level HTTP cache, which
         may be read-only in restricted environments; disable it to keep builds
         warning-free. Re-enable on a normal dev machine / in CI. -->
    <add key="NuGetAudit" value="false" />
  </config>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
