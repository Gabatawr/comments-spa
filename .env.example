# ===========================================================================
# SPA «Комментарии» — local dev environment (NON-SECRET defaults only)
#
# Copy to `.env` (`cp .env.example .env`) and edit if needed.
# `.env` is git-ignored; docker compose reads it automatically.
# Every value below is a plain local-dev default — there are no secrets here.
# ===========================================================================

# --- Docker Compose project (also fixed by `name:` in docker-compose.yml) ---
# COMPOSE_PROJECT_NAME=comments-spa

# --- Host port mappings (host -> container) --------------------------------
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672
ELASTIC_HOST_PORT=59200
API_HOST_PORT=8081
WEB_HOST_PORT=8080

# --- PostgreSQL (API-v2 §10) ------------------------------------------------
POSTGRES_DB=comments
POSTGRES_USER=comments
POSTGRES_PASSWORD=comments

# --- Redis (cache + captcha store) ------------------------------------------
# Empty password = no AUTH in local dev. Use `redis://:pass@redis:6379` if set.
REDIS_CONNECTION_STRING=redis:6379

# --- RabbitMQ (API-v2 §7, §10) ----------------------------------------------
# Non-guest default user: the built-in `guest` account is loopback-only and is
# rejected from other containers, so the stack defaults to comments/comments.
RABBITMQ_DEFAULT_USER=comments
RABBITMQ_DEFAULT_PASS=comments
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_CONNECTION_STRING=amqp://comments:comments@rabbitmq:5672/

# --- Elasticsearch (search) -------------------------------------------------
ELASTIC_URL=http://elasticsearch:9200

# --- API providers / feature flags (API-v2 §10) -----------------------------
# Default stack is Production: dev seed/captcha-peek endpoints return 404.
# For load/seeding use the override (Development + both flags forced true):
#   docker compose -f docker-compose.yml -f infra/compose.dev.yml up -d --build
ASPNETCORE_ENVIRONMENT=Production
CACHE_PROVIDER=redis
MESSAGING_PROVIDER=rabbitmq
SEARCH_ENABLED=true
STORAGE_PROVIDER=filesystem
PROXY_TRUST_ALL=true
FEATURES_DEV_CAPTCHA_PEEK=false
FEATURES_SEED=false

# --- k6 load profile --------------------------------------------------------
K6_BASE_URL=http://api:8080
K6_WS_URL=ws://api:8080/ws
K6_API_URL=http://api:8080
RUN_LABEL=default

# --- Seed helper (`tools` profile) ------------------------------------------
SEED_API_BASE_URL=http://api:8080
SEED_COUNT=10000
SEED_ROOTS=1000
SEED_DEPTH=3
SEED_BATCH_SIZE=1000
SEED_CLEAR=false
