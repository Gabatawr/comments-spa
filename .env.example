# ===========================================================================
# SPA «Комментарии» — local dev environment (NON-SECRET defaults only)
#
# Copy to `.env` (`cp .env.example .env`) and edit if needed.
# `.env` is git-ignored; docker compose reads it automatically.
# Every value below is a plain local-dev default — there are no secrets here.
# ===========================================================================

# --- Docker Compose project (also fixed by `name:` in docker-compose.yml) ---
# COMPOSE_PROJECT_NAME=comments-spa

# --- Host port mappings (host -> container) --------------------------------
# Only the SPA is published on every interface. The data services and the API bind to 127.0.0.1, so
# a dev stack on a shared network is not an open Postgres/Redis/RabbitMQ/Elasticsearch, and the
# Development-only /api/dev/* endpoints cannot be reached from outside the host. Prefix a value with
# an address to change that (e.g. 0.0.0.0:8081, deliberately).
POSTGRES_HOST_PORT=127.0.0.1:55432
REDIS_HOST_PORT=127.0.0.1:56379
RABBITMQ_HOST_PORT=127.0.0.1:5672
RABBITMQ_MGMT_HOST_PORT=127.0.0.1:15672
ELASTIC_HOST_PORT=127.0.0.1:59200
API_HOST_PORT=127.0.0.1:8081
WEB_HOST_PORT=8080

# --- PostgreSQL (API-v2 §10) ------------------------------------------------
POSTGRES_DB=comments
POSTGRES_USER=comments
POSTGRES_PASSWORD=comments

# --- Redis (cache + captcha store) ------------------------------------------
# Empty password = no AUTH in local dev. Use `redis://:pass@redis:6379` if set.
REDIS_CONNECTION_STRING=redis:6379

# --- RabbitMQ (API-v2 §7, §10) ----------------------------------------------
# Non-guest default user: the built-in `guest` account is loopback-only and is
# rejected from other containers, so the stack defaults to comments/comments.
RABBITMQ_DEFAULT_USER=comments
RABBITMQ_DEFAULT_PASS=comments
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_CONNECTION_STRING=amqp://comments:comments@rabbitmq:5672/

# --- Elasticsearch (search) -------------------------------------------------
ELASTIC_URL=http://elasticsearch:9200

# --- Provider switchboard (docs/ARCHITECTURE-v2.md §3) ------------------------
# Default stack is Production: dev seed/captcha-peek endpoints return 404.
# For load/seeding use the override (Development + both flags forced true):
#   docker compose -f docker-compose.yml -f infra/compose.dev.yml up -d --build
#
# Which adapter answers for each port. `GET /api/info` returns the resolved matrix (active value,
# status, description and every alternative) so a deployment can be inspected without reading env.
#   database : postgres | mssql*
#   cache    : redis | memory
#   messaging: rabbitmq | inmemory
#   search   : elastic | none
#   storage  : filesystem | s3 | azureblob
# (*) declared seam, not implemented — selecting it fails fast with a precise message.
ASPNETCORE_ENVIRONMENT=Production
PROVIDERS_DATABASE=postgres
PROVIDERS_CACHE=redis
PROVIDERS_MESSAGING=rabbitmq
PROVIDERS_SEARCH=elastic
PROVIDERS_STORAGE=filesystem
# Unknown/unimplemented provider = startup error instead of a silent fallback.
PROVIDERS_STRICT=true
# Selected provider unreachable = startup error instead of silent degradation.
# Leave false locally (health reports the degraded port), set true in production.
PROVIDERS_FAIL_FAST=false

# --- Managed search (Elastic Cloud / OpenSearch Service / Aiven) -------------
# Leave empty for the local unauthenticated container.
SEARCH_USERNAME=
SEARCH_PASSWORD=
SEARCH_API_KEY=

# --- Storage: s3 (set PROVIDERS_STORAGE=s3) ----------------------------------
# `infra/compose.s3.yml` starts a local S3-compatible server with exactly these values.
# Empty ServiceUrl = AWS; empty credentials = the SDK chain (env/profile/instance role).
S3_SERVICE_URL=
S3_BUCKET=comments-attachments
S3_PREFIX=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=
S3_USE_HTTP=
# Leave empty in the cloud: the AWS SDK then uses its default chain (environment variables,
# shared profile, ECS task role, EC2 instance role). The local S3 profile sets its own defaults.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Storage: azureblob (set PROVIDERS_STORAGE=azureblob) --------------------
# Either a connection string, or AccountUrl + SAS token, or AccountUrl alone for
# DefaultAzureCredential (managed identity — no secret in the environment).
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_ACCOUNT_URL=
AZURE_BLOB_SAS_TOKEN=
AZURE_BLOB_CONTAINER=comments-attachments
AZURE_BLOB_PREFIX=

PROXY_TRUST_ALL=true
FEATURES_DEV_CAPTCHA_PEEK=false
FEATURES_SEED=false

# --- k6 load profile --------------------------------------------------------
K6_BASE_URL=http://api:8080
K6_WS_URL=ws://api:8080/ws
K6_API_URL=http://api:8080
RUN_LABEL=default

# --- Seed helper (`tools` profile) ------------------------------------------
SEED_API_BASE_URL=http://api:8080
SEED_COUNT=10000
SEED_ROOTS=1000
SEED_DEPTH=3
SEED_BATCH_SIZE=1000
SEED_CLEAR=false
