# Build context exclusions for the Docker image.
**/bin/
**/obj/
**/.vs/
**/TestResults/
**/*.user

# Repo-local NuGet caches (restore happens inside the image)
.nuget/
**/.nuget/
**/.nuget-packages/

.git/
.gitignore
.github/

# QA assets are not needed in the runtime image.
tests/
docs/
TASK.md
AGENTS.md

# Local secrets: never ship `.env` (only the non-secret example).
.env
.env.*
!.env.example

# Infra / load-test assets are not part of the app build context.
infra/
perf/

# Local state
*.db
*.db-shm
*.db-wal
**/storage/
**/wwwroot/

node_modules/
**/node_modules/

# Editor / OS
.idea/
.vscode/
.DS_Store
*.log

Dockerfile
docker-compose.yml
.dockerignore

# Docker buildx state (sandbox workaround)
.buildx/
