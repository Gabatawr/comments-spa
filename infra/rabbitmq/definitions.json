        "x-dead-letter-routing-key": "comments.events.ws.dlq"
      }
    },
    {
      "name": "comments.events.ws.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "comments.events.search",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "comments.dlx",
        "x-dead-letter-routing-key": "comments.events.search.dlq"
      }
    },
    {
      "name": "comments.events.search.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
