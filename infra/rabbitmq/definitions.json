    },
    {
      "name": "comments.events.retry",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-message-ttl": 5000,
        "x-dead-letter-exchange": "comments.events"
      }
    }
  ],
  "exchanges": [
    {
      "name": "comments.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
