<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Comments.Application</RootNamespace>
    <AssemblyName>Comments.Application</AssemblyName>
  </PropertyGroup>

  <!--
    Application depends on Domain only. Ports (abstractions) live here;
    implementations live in Comments.Infrastructure.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Comments.Domain\Comments.Domain.csproj" />
  </ItemGroup>

  <!--
    Only abstraction packages (DI/options). No persistence, web, cache-broker, search or imaging
    package may appear here (docs/ARCHITECTURE-v2.md §1).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
